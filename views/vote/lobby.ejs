<%- include('../partials/header') %>

<h1>Lobby: <%= code %></h1>

<input type="text" value="<%= code %>" disabled>
<button>Copy code</button> 
<br>

<span>User List:</span> <br>
<ul>
    <% if (!lobby.users || lobby.users.length === 0) { %>
        <li>No users yet</li>
    <% } else { %>  
        <% lobby.users.forEach(u => { %>
            <li>
                <%= u.username %>
                <% if (u.id === lobby.createdBy) { %> (HOST) <% } %>
                <%= u.ready ? "READY" : "NOT READY" %>
                <% if (u.id === currentUserId) { %> (you) <% } %>
            </li>
        <% }) %>
    <% } %>

</ul> <br>

<form action="/vote/lobby/ready" method="POST">
    <input type="hidden" name="code" value="<%= code %>">

    <% const me = (lobby.users || []).find(u => u.id === currentUserId); %>
    <button type="submit">
        <%= me && me.ready ? "Unready" : "Ready Up" %>
    </button>
</form>

<a href="/"><button type="button">Leave</button></a>

<% if (isHost){ %>
    <p>Once everyone is ready voting will begin!</p>

    <% if (!everyoneReady) { %>
        <p>Waiting for everyone to ready up…</p>
    <% } %>
    <% } else { %>
        <button type="button" disabled>Waiting for host…</button>
    <% } %>

    <script>
	(function () {
		const code = "<%= code %>";

		async function checkReady() {
			try{
				const res = await fetch(`/vote/lobby/status?code=${encodeURIComponent(code)}`);
				if (!res.ok) return;

				const data = await res.json();
				if (data.everyoneReady){
					window.location.href = `/vote/choices?code=${encodeURIComponent(code)}`;
				}
			}catch (e) {}
		}

		setInterval(checkReady, 2000);
		checkReady();
	})();
</script>
    
<%- include('../partials/footer') %>