
  <%- include('../partials/header') %>

  <div class="container">
      <div class="card">
          <h1 class="page-title">Select 5 Movies</h1>

          <!-- ═══════════════════════════════════════════ -->
          <!-- SEARCH BOX -->
          <!-- ═══════════════════════════════════════════ -->
          <div class="form-group">
              <input
                  type="text"
                  id="movie-search"
                  class="form-input"
                  placeholder="Search for movies..."
                  autocomplete="off"
              >
              <p id="selection-message" class="selection-message">Select 5 movies to continue</p>
          </div>

          <!-- ═══════════════════════════════════════════ -->
          <!-- SEARCH RESULTS -->
          <!-- ═══════════════════════════════════════════ -->
          <div id="search-results" class="search-results"></div>

          <!-- ═══════════════════════════════════════════ -->
          <!-- SELECTED MOVIES -->
          <!-- ═══════════════════════════════════════════ -->
          <div class="selected-section">
              <h3>Selected Movies (<span id="count">0</span>/5)</h3>
              <div id="selected-movies" class="selected-movies"></div>
          </div>

          <!-- ═══════════════════════════════════════════ -->
          <!-- START VOTING BUTTON -->
          <!-- ═══════════════════════════════════════════ -->
		  <form action="/vote/wait" method="POST">
			  <input type="hidden" name="code" value="<%= code %>">
			  <input type="hidden" name="act" value="choice">
			  <input id="userChoices" name="userChoices" value=""> 
			  <button
				  id="start-voting-btn"
				  class="btn btn-primary"
				  type="submit"
				  disabled
			  >
				  Start Voting
			  </button>
		  </form>
      </div>
  </div>

  <script src="/javascripts/vote-search.js"></script>
  <%- include('../partials/footer') %>