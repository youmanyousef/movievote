
<%- include('../partials/header') %>

<div class="container">
    <div class="card">
        <h1 class="page-title">Rate the Movies</h1>

        <!-- ═══════════════════════════════════════════ -->
        <!-- PROGRESS INDICATOR -->
        <!-- ═══════════════════════════════════════════ -->
        <div class="voting-progress">
            <p id="progress-text">Rated <span id="rated-count">0</span> of <span id="total-count">15</span> movies</p>
            <div class="progress-bar">
                <div id="progress-fill" class="progress-fill"></div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════ -->
        <!-- MOVIES GRID -->
        <!-- ═══════════════════════════════════════════ -->
        <div id="voting-grid" class="voting-grid">
            <!-- Movies will be rendered here by JavaScript -->
        </div>

        <!-- ═══════════════════════════════════════════ -->
        <!-- SUBMIT BUTTON -->
        <!-- ═══════════════════════════════════════════ -->
        <button
            id="submit-votes-btn"
            class="btn btn-primary"
            onclick="submitVotes()"
            disabled
        >
            Submit Votes
        </button>
    </div>
</div>

<!-- Load dummy data and voting script -->
<script src="/js/dummy-data.js"></script>
<script src="/js/voting-page.js"></script>
<%- include('../partials/footer') %>
