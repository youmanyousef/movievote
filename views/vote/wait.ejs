<%- include('../partials/header') %>

<form id="nextPage" action="" method="POST">
	<input type="hidden" name="code" value="<%= code %>">
	<button type="button" class="btn btn-primary" disabled>Please wait...</button>
</form>

<script>
	const code = "<%= code %>";
	const pollUrl = "<%= pollUrl %>";
	const nextUrl = "<%= nextUrl %>";

	async function checkReady() {
		try{
			const res = await fetch(pollUrl, {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ code })
				});

				const data = await res.json();

				if(data.message === true){
					window.location.href = `${nextUrl}?code=${encodeURIComponent(code)}`;
				}
			}catch(error){
				console.error("Polling failed:", error);
			}
		}
	setInterval(checkReady, 1000);
	checkReady();
</script>

<%- include('../partials/footer') %>