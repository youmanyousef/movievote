<%- include('../partials/header') %>
	<div class="container">
          <div class="landing-card">
              <div class="logo-section">
                  <h1 class="app-title">🎬 MovieVote</h1>
                  <p class="app-tagline">Vote together, watch together</p>
              </div>

              <div class="button-group">
				  <% if (isAuthenticated) { %>
					<a href="/vote/join" class="btn btn-primary">Join Lobby</a>
					<a href="/vote/create" class="btn btn-primary">Create Lobby</a>
					<a href="/auth/logout" class="btn btn-secondary">Logout</a>
				  <% } else { %>
					<a href="/auth/login" class="btn btn-primary">Login</a>
					<a href="/auth/register" class="btn btn-secondary">Register</a>
				  <% } %>
              </div>
          </div>
      </div>
<%- include('../partials/footer') %>
