<form action="?">
	<input type="checkbox" id="enableShows" value="Shows">
	<label for="enableShows">Enable Shows?</label><br>
	<input type="checkbox" id="enableMovies" value="Movies">
	<label for="enableMovies">Enable Movies?</label><br>
	<input type="checkbox" id="setTimer" value="TimeSet">
